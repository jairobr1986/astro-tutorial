---
interface Props {
  platform: string;
  username: string;
}

const { platform, username } = Astro.props as Props;
const normalizedPlatform = platform.toLowerCase();

const icons = {
  github: {
    viewBox: "0 0 24 24",
    path: "M12 .5A11.5 11.5 0 0 0 8.36 22.9c.58.11.79-.25.79-.56v-2.2c-3.22.7-3.9-1.38-3.9-1.38-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.04 1.76 2.72 1.25 3.38.96.11-.75.41-1.25.74-1.54-2.57-.29-5.27-1.28-5.27-5.72 0-1.26.45-2.3 1.19-3.11-.12-.29-.52-1.47.11-3.07 0 0 .97-.31 3.17 1.19A10.9 10.9 0 0 1 12 5.88c.98 0 1.96.13 2.88.39 2.2-1.5 3.17-1.19 3.17-1.19.63 1.6.23 2.78.11 3.07.74.81 1.19 1.85 1.19 3.11 0 4.45-2.71 5.43-5.29 5.72.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z",
  },
  instagram: {
    viewBox: "0 0 24 24",
    path: "M7.8 2h8.4A5.8 5.8 0 0 1 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8A5.8 5.8 0 0 1 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2Zm0 2A3.8 3.8 0 0 0 4 7.8v8.4A3.8 3.8 0 0 0 7.8 20h8.4a3.8 3.8 0 0 0 3.8-3.8V7.8A3.8 3.8 0 0 0 16.2 4H7.8Zm8.7 2.4a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2ZM12 7.2a4.8 4.8 0 1 1 0 9.6 4.8 4.8 0 0 1 0-9.6Zm0 2a2.8 2.8 0 1 0 0 5.6 2.8 2.8 0 0 0 0-5.6Z",
  },
  linkedin: {
    viewBox: "0 0 24 24",
    path: "M4.98 3.5a2.5 2.5 0 1 1 0 5.01 2.5 2.5 0 0 1 0-5.01ZM3 21h4V9.75H3V21Zm6.5-11.25h3.83v1.54h.05c.53-1 1.84-2.05 3.79-2.05 4.05 0 4.8 2.66 4.8 6.12V21h-4v-5.01c0-1.2-.02-2.73-1.67-2.73-1.67 0-1.93 1.3-1.93 2.64V21h-4V9.75Z",
  },
};

// 1. Criamos variáveis vazias que vão mudar dependendo da rede
let domain = "com";
let prefix = "";
let icon = icons[normalizedPlatform as keyof typeof icons];
let fallbackText = platform.slice(0, 2).toUpperCase();

// 2. Analisamos qual é a plataforma atual
switch (normalizedPlatform) {
  case "linkedin":
    prefix = "in/";
    break;
  case "youtube":
  case "tiktok":
    prefix = "@";
    break;
  case "bluesky":
    domain = "app"; // Muda de .com para .app
    prefix = "profile/";
    break;
  // Se for github, instagram, twitter, etc., entra aqui e não muda nada
  default:
    prefix = "";
    domain = "com";
}
---

<!-- 3. Montamos a URL usando as variáveis inteligentes que criamos acima -->
<a
  class="social-link"
  href={`https://www.${platform}.${domain}/${prefix}${username}`}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${platform}: ${username}`}
  title={`${platform}: ${username}`}
>
  {
    icon ? (
      <svg
        aria-hidden="true"
        viewBox={icon.viewBox}
        width="22"
        height="22"
        fill="currentColor"
      >
        <path d={icon.path}></path>
      </svg>
    ) : (
      <span aria-hidden="true">{fallbackText}</span>
    )
  }
</a>

<style>
  .social-link {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    color: var(--accent-contrast);
    background-color: var(--accent);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 800;
    line-height: 1;
  }

  .social-link:hover,
  .social-link:focus-visible {
    transform: translateY(-1px);
  }
</style>
