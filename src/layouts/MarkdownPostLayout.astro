---
import BaseLayout from "./BaseLayout.astro";

const { data } = Astro.props;
const { title, description, pubDate, author, image, tags } = data;
---

<BaseLayout pageTitle={title}>
  <p><em>{description}</em></p>
  <p>{pubDate instanceof Date ? pubDate.toISOString().slice(0, 10) : pubDate}</p>

  <p>Escrito por: {author}</p>

  <img src={image?.url} width="300" alt={image?.alt} />

  <div class="tags">
    {tags?.map((tag) => (
      <p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p>
    ))}
  </div>

  <slot />

</BaseLayout>

<style>
  a {
    color: #00539F;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
  }

  .tag {
    margin: 0.25em;
    border: dotted 1px #a1a1a1;
    border-radius: .5em;
    padding: .5em 1em;
    font-size: 1.15em;
    background-color: #F8FCFD;
  }
</style>