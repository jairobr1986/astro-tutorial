---
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Sobre Mim";
const pageDescription = "Conheca Jairo Oliveira Santos, sua jornada com Astro e a base para criacao de sites estaticos.";

const identify = {
  firstName: "Jairo",
  country: "Brasil",
  occupation: "Supervisor",
  hobbies: ["tecnologia", "programação", "aprendizado"],
};

const skills = [
  "HTML",
  "CSS",
  "JavaScript",
  "Python",
  "Astro",
  "Escrever Documentação",
];

const happy = true;
const finished = true;
const goal = 3;

let sistemaOperacional = "Linux";
const quantidade = 3;
const calcado = "botas";
const estudante = false;
---

<BaseLayout pageTitle={pageTitle} pageDescription={pageDescription}>
  <h2>... e meu novo site Astro!</h2>

  <p>
    Estou resolvendo o tutorial introdutório do Astro. Esta é a segunda página
    no meu website, e é a primeira que eu mesmo construí!
  </p>

  <p>
    Este site será atualizado enquanto eu completo mais desse tutorial, então
    continue verificando e veja como minha jornada está indo!
  </p>

  <p>Aqui estão alguns fatos sobre mim:</p>

  {happy && <p>Estou feliz em estar aprendendo Astro!</p>}

  {finished && <p>Eu terminei esse tutorial!</p>}

  {
    goal === 3 ? (
      <p>Minha meta é terminar em 3 dias.</p>
    ) : (
      <p>Minha meta não é em 3 dias.</p>
    )
  }

  <ul>
    <li>Meu nome é {identify.firstName}.</li>
    <li>
      Eu moro no {identify.country} e eu trabalho como {identify.occupation}.
    </li>
    {
      identify.hobbies.length >= 2 && (
        <li>
          Dois do meu hobbies são: {identify.hobbies[0]}, {identify.hobbies[1]}.
        </li>
      )
    }

    <ul>
      <p>Minhas habilidades são:</p>
    </ul>
    <ul>
      {skills.map((skill) => <li class="skill"> {skill} </li>)}
    </ul>

    <p>{sistemaOperacional}</p>

    {estudante && <p> Ainda estou na escola</p>}

    <p>Eu tenho {quantidade + 8} pares de {calcado}.</p>

    {
      sistemaOperacional === "MacOS" ? (
        <p>Estou utilizando Mac</p>
      ) : (
        <p> Não estou utilizando Mac.</p>
      )
    }
  </ul>
</BaseLayout>
